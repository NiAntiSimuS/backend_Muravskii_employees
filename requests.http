# Запросы для демонстрации лабораторной 2.
# В VS Code используется расширение REST Client; в JetBrains IDE есть поддержка .http.

@base = http://localhost:8000

### 1. Проверить сервис (200)
GET {{base}}/health

### 2. Создать отдел (201)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "Разработка",
  "manager": "Анна Смирнова",
  "status": "active"
}

### 3. Создать другой отдел (201)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "Маркетинг",
  "manager": "Иван Петров",
  "status": "inactive"
}

### 4. Список отделов (200)
GET {{base}}/api/departments

### 5. Пагинация (200)
GET {{base}}/api/departments?limit=1&offset=0

### 6. Фильтр по руководителю (200)
GET {{base}}/api/departments?manager=Анна%20Смирнова

### 7. Фильтр по статусу (200)
GET {{base}}/api/departments?status=active

### 8. Получить отдел (200, если id=1 существует)
GET {{base}}/api/departments/1

### 9. Неизвестный отдел (404)
GET {{base}}/api/departments/999999

### 10. Изменить отдел (200)
PATCH {{base}}/api/departments/1
Content-Type: application/json

{
  "manager": "Иван Петров"
}

### 11. Создать сотрудника отдела 1 (201)
POST {{base}}/api/departments/1/employees
Content-Type: application/json

{
  "full_name": "Иван Иванов",
  "position": "Разработчик",
  "email": "ivan@example.com",
  "salary": 90000
}

### 12. Получить сотрудников отдела (200, список)
GET {{base}}/api/departments/1/employees

### 13. Создать сотрудника несуществующего отдела (404)
POST {{base}}/api/departments/999999/employees
Content-Type: application/json

{
  "full_name": "Пётр Петров",
  "position": "Аналитик",
  "email": "petr@example.com",
  "salary": 70000
}

### 14. Проверка защиты от SQL-инъекции (201)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "'); DROP TABLE departments;--",
  "manager": "Анна Смирнова",
  "status": "active"
}

### 15. Проверка, что таблица сохранилась (200)
GET {{base}}/api/departments

### 16. Пустое название (400, field=name)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "",
  "manager": "Анна Смирнова",
  "status": "active"
}

### 17. Нет обязательного поля name (400, field=name)
POST {{base}}/api/departments
Content-Type: application/json

{
  "manager": "Анна Смирнова",
  "status": "active"
}

### 18. Пустой manager (400, field=manager)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "Продажи",
  "manager": "",
  "status": "active"
}

### 19. Некорректный status (400, field=status)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "Продажи",
  "manager": "Олег Орлов",
  "status": "wrong"
}

### 20. Сломанный JSON (400)
POST {{base}}/api/departments
Content-Type: application/json

{
  "name": "Продажи",
  "manager": "Олег Орлов",

### 21. Удалить отдел 1 (204; сотрудников тоже удалит)
DELETE {{base}}/api/departments/1

### 22. После удаления отдел не существует (404)
GET {{base}}/api/departments/1

### 23. ★ Поиск по названию (без учёта регистра, включая кириллицу)
GET {{base}}/api/departments?q=РАЗРАБ

### 24. ★ Поиск с дополнительным фильтром
GET {{base}}/api/departments?q=раз&status=active

### 25. ★★ Уникальный email: первый сотрудник (201)
POST {{base}}/api/departments/1/employees
Content-Type: application/json

{
  "full_name": "Первый Сотрудник",
  "position": "Инженер",
  "email": "unique@example.com",
  "salary": 100000
}

### 26. ★★ Повтор email с другим регистром (409, field=email)
POST {{base}}/api/departments/1/employees
Content-Type: application/json

{
  "full_name": "Второй Сотрудник",
  "position": "Инженер",
  "email": "UNIQUE@example.com",
  "salary": 105000
}

### 27. ★★ Статистика отделов (200, включая пустые отделы)
GET {{base}}/api/departments/stats
